<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Applies to release/debug, WebView and the Android/Ktor HTTP stack. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
