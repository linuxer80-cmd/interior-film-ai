import { NextResponse } from "next/server";
import { createClient } from "@supabase/supabase-js";

export const runtime = "nodejs";
export const maxDuration = 60;


/*
 * =========================================================
 * Supabase Service Role Client
 * =========================================================
 */

function getAdminSupabase() {
  const supabaseUrl =
    process.env.NEXT_PUBLIC_SUPABASE_URL;

  const serviceRoleKey =
    process.env.SUPABASE_SERVICE_ROLE_KEY;

  if (!supabaseUrl) {
    throw new Error(
      "NEXT_PUBLIC_SUPABASE_URL 환경변수가 없습니다.",
    );
  }

  if (!serviceRoleKey) {
    throw new Error(
      "SUPABASE_SERVICE_ROLE_KEY 환경변수가 없습니다.",
    );
  }

  return createClient(
    supabaseUrl,
    serviceRoleKey,
    {
      auth: {
        persistSession: false,
        autoRefreshToken: false,
      },
    },
  );
}


/*
 * =========================================================
 * Bearer Token
 * =========================================================
 */

function getBearerToken(request) {
  const authorization =
    request.headers.get("authorization");

  if (!authorization) {
    return "";
  }

  const [scheme, token] =
    authorization.split(" ");

  if (
    String(scheme || "").toLowerCase() !==
    "bearer"
  ) {
    return "";
  }

  return token || "";
}


/*
 * =========================================================
 * 취소 알림
 *
 * 알림 실패 때문에 취소 예약 자체를 실패시키지 않습니다.
 * =========================================================
 */

async function createCancellationNotifications({
  admin,
  company,
  subscription,
  userId,
}) {
  try {
    const periodEnd =
      subscription.current_period_end
        ? new Date(
            subscription.current_period_end,
          ).toLocaleString(
            "ko-KR",
            {
              timeZone: "Asia/Seoul",
              year: "numeric",
              month: "2-digit",
              day: "2-digit",
              hour: "2-digit",
              minute: "2-digit",
            },
          )
        : "현재 이용기간 종료일";

    /*
     * ---------------------------------------------------------
     * 업체 관리자 알림
     * ---------------------------------------------------------
     */

    const {
      error: companyNotificationError,
    } =
      await admin
        .from("notifications")
        .insert({
          company_id:
            company.id,

          recipient_type:
            "company_admin",

          recipient_user_id:
            userId,

          recipient_worker_id:
            null,

          type:
            "subscription_cancel_scheduled",

          priority:
            "warning",

          title:
            "구독 취소가 예약되었습니다.",

          message:
            `${periodEnd}까지 현재 요금제를 이용할 수 있으며, 이후 자동결제가 중단됩니다.`,

          link:
            "/admin/billing",

          reference_type:
            "subscription",

          reference_id:
            subscription.id,

          dedupe_key:
            `subscription_cancel_scheduled:${subscription.id}:${subscription.current_period_end}:${userId}`,

          is_read:
            false,

          push_sent:
            false,
        });

    if (
      companyNotificationError &&
      companyNotificationError.code !==
        "23505"
    ) {
      console.error(
        "[billing/cancel] company notification error:",
        companyNotificationError,
      );
    }


    /*
     * ---------------------------------------------------------
     * 슈퍼관리자 알림
     * ---------------------------------------------------------
     */

    const {
      data: superAdmins,
      error: superAdminError,
    } =
      await admin
        .from("super_admins")
        .select("user_id")
        .eq(
          "is_active",
          true,
        );

    if (superAdminError) {
      console.error(
        "[billing/cancel] super admin lookup error:",
        superAdminError,
      );

      return;
    }

    for (
      const superAdmin
      of superAdmins || []
    ) {
      const {
        error: notificationError,
      } =
        await admin
          .from("notifications")
          .insert({
            company_id:
              company.id,

            recipient_type:
              "super_admin",

            recipient_user_id:
              superAdmin.user_id,

            recipient_worker_id:
              null,

            type:
              "subscription_cancel_scheduled",

            priority:
              "warning",

            title:
              "업체 구독 취소 예약",

            message:
              `${company.company_name} 업체가 구독 취소를 예약했습니다.\n이용 종료 예정: ${periodEnd}`,

            link:
              "/super-admin/billing",

            reference_type:
              "subscription",

            reference_id:
              subscription.id,

            dedupe_key:
              `subscription_cancel_scheduled:${subscription.id}:${subscription.current_period_end}:super_admin:${superAdmin.user_id}`,

            is_read:
              false,

            push_sent:
              false,
          });

      if (
        notificationError &&
        notificationError.code !==
          "23505"
      ) {
        console.error(
          "[billing/cancel] super admin notification error:",
          notificationError,
        );
      }
    }
  } catch (error) {
    console.error(
      "[billing/cancel] notification error:",
      error,
    );
  }
}


/*
 * =========================================================
 * POST /api/billing/cancel
 *
 * 현재 결제기간 종료 시 취소 예약
 *
 * - owner만 가능
 * - 즉시 서비스 중단하지 않음
 * - subscription_plan 변경하지 않음
 * - status는 active 유지
 * - cancel_at_period_end = true
 * - 다음 자동결제 대상에서 제외
 * =========================================================
 */

export async function POST(request) {
  const admin =
    getAdminSupabase();

  try {
    /*
     * =====================================================
     * 1. 로그인 확인
     * =====================================================
     */

    const accessToken =
      getBearerToken(request);

    if (!accessToken) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "로그인이 필요합니다.",
        },
        {
          status: 401,
        },
      );
    }

    const {
      data: userData,
      error: userError,
    } =
      await admin.auth.getUser(
        accessToken,
      );

    if (
      userError ||
      !userData?.user
    ) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "로그인 정보를 확인할 수 없습니다.",
        },
        {
          status: 401,
        },
      );
    }

    const user =
      userData.user;


    /*
     * =====================================================
     * 2. 로그인 사용자의 업체/권한 확인
     * =====================================================
     */

    const {
      data: profile,
      error: profileError,
    } =
      await admin
        .from("profiles")
        .select(
          `
            id,
            company_id,
            name,
            role,
            is_active
          `,
        )
        .eq(
          "id",
          user.id,
        )
        .maybeSingle();

    if (profileError) {
      throw new Error(
        "사용자 정보를 확인하지 못했습니다.",
      );
    }

    if (
      !profile ||
      !profile.company_id
    ) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "소속 업체를 확인할 수 없습니다.",
        },
        {
          status: 403,
        },
      );
    }

    if (
      profile.is_active === false
    ) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "비활성화된 관리자 계정입니다.",
        },
        {
          status: 403,
        },
      );
    }


    /*
     * 구독 취소는 업체 owner만 가능
     */

    if (
      String(
        profile.role || "",
      ).toLowerCase() !==
      "owner"
    ) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "구독 취소는 업체 소유자만 할 수 있습니다.",
        },
        {
          status: 403,
        },
      );
    }


    /*
     * =====================================================
     * 3. 업체 확인
     * =====================================================
     */

    const {
      data: company,
      error: companyError,
    } =
      await admin
        .from("companies")
        .select(
          `
            id,
            company_name,
            subscription_plan,
            is_active
          `,
        )
        .eq(
          "id",
          profile.company_id,
        )
        .maybeSingle();

    if (companyError) {
      throw new Error(
        "업체 정보를 확인하지 못했습니다.",
      );
    }

    if (!company) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "업체를 찾을 수 없습니다.",
        },
        {
          status: 404,
        },
      );
    }

    if (
      company.is_active === false
    ) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "비활성화된 업체입니다.",
        },
        {
          status: 403,
        },
      );
    }


    /*
     * =====================================================
     * 4. 현재 구독 확인
     * =====================================================
     */

    const {
      data: subscription,
      error: subscriptionError,
    } =
      await admin
        .from("subscriptions")
        .select(
          `
            id,
            company_id,
            plan_code,
            status,
            monthly_price_krw,
            started_at,
            current_period_start,
            current_period_end,
            next_billing_at,
            cancel_at_period_end,
            canceled_at,
            payment_retry_count,
            last_payment_retry_at,
            next_payment_retry_at,
            created_at,
            updated_at
          `,
        )
        .eq(
          "company_id",
          company.id,
        )
        .maybeSingle();

    if (subscriptionError) {
      throw new Error(
        "구독 정보를 확인하지 못했습니다.",
      );
    }

    if (!subscription) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "취소할 구독이 없습니다.",
        },
        {
          status: 404,
        },
      );
    }


    /*
     * =====================================================
     * 5. 취소 가능한 상태 확인
     * =====================================================
     */

    if (
      subscription.status ===
      "canceled"
    ) {
      return NextResponse.json(
        {
          ok: true,
          alreadyCanceled: true,
          cancelScheduled: false,
          message:
            "이미 취소된 구독입니다.",
          subscription,
        },
        {
          status: 200,
        },
      );
    }

    if (
      subscription.cancel_at_period_end ===
      true
    ) {
      return NextResponse.json(
        {
          ok: true,
          alreadyScheduled: true,
          cancelScheduled: true,
          message:
            "이미 구독 취소가 예약되어 있습니다.",
          subscription,
        },
        {
          status: 200,
        },
      );
    }

    if (
      subscription.status !==
        "active" &&
      subscription.status !==
        "past_due"
    ) {
      return NextResponse.json(
        {
          ok: false,
          error:
            `현재 구독 상태(${subscription.status})에서는 취소 예약을 할 수 없습니다.`,
        },
        {
          status: 409,
        },
      );
    }


    /*
     * =====================================================
     * 6. 이용기간 종료일 확인
     * =====================================================
     */

    if (
      !subscription.current_period_end
    ) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "현재 구독의 이용기간 종료일을 확인할 수 없습니다.",
        },
        {
          status: 409,
        },
      );
    }

    const periodEnd =
      new Date(
        subscription.current_period_end,
      );

    if (
      Number.isNaN(
        periodEnd.getTime(),
      )
    ) {
      return NextResponse.json(
        {
          ok: false,
          error:
            "현재 구독의 이용기간 종료일이 올바르지 않습니다.",
        },
        {
          status: 409,
        },
      );
    }


    /*
     * =====================================================
     * 7. 취소 예약
     *
     * 중요:
     * - status는 그대로 유지
     * - company.subscription_plan도 그대로 유지
     * - current_period_end까지 이용 가능
     * - renew API에서는 cancel_at_period_end=true를
     *   자동결제 대상에서 제외
     * =====================================================
     */

    const now =
      new Date().toISOString();

    const {
      data: updatedSubscription,
      error: updateError,
    } =
      await admin
        .from("subscriptions")
        .update({
          cancel_at_period_end:
            true,

          /*
           * 예약 시점에는 아직 실제 취소가 아니므로
           * canceled_at은 NULL 유지
           */
          canceled_at:
            null,

          /*
           * 재시도 예약이 남아 있으면 제거합니다.
           * 취소 예약 이후 새 자동결제가 실행되면 안 됩니다.
           */
          next_payment_retry_at:
            null,

          updated_at:
            now,
        })
        .eq(
          "id",
          subscription.id,
        )
        .eq(
          "company_id",
          company.id,
        )
        .eq(
          "cancel_at_period_end",
          false,
        )
        .select(
          `
            id,
            company_id,
            plan_code,
            status,
            monthly_price_krw,
            started_at,
            current_period_start,
            current_period_end,
            next_billing_at,
            cancel_at_period_end,
            canceled_at,
            payment_retry_count,
            last_payment_retry_at,
            next_payment_retry_at,
            created_at,
            updated_at
          `,
        )
        .maybeSingle();

    if (updateError) {
      throw new Error(
        "구독 취소 예약을 저장하지 못했습니다.",
      );
    }


    /*
     * 동시 요청 등으로 이미 변경된 경우 다시 조회
     */

    let finalSubscription =
      updatedSubscription;

    if (!finalSubscription) {
      const {
        data: latestSubscription,
        error: latestError,
      } =
        await admin
          .from("subscriptions")
          .select(
            `
              id,
              company_id,
              plan_code,
              status,
              monthly_price_krw,
              started_at,
              current_period_start,
              current_period_end,
              next_billing_at,
              cancel_at_period_end,
              canceled_at,
              payment_retry_count,
              last_payment_retry_at,
              next_payment_retry_at,
              created_at,
              updated_at
            `,
          )
          .eq(
            "id",
            subscription.id,
          )
          .maybeSingle();

      if (
        latestError ||
        !latestSubscription
      ) {
        throw new Error(
          "구독 취소 예약 결과를 확인하지 못했습니다.",
        );
      }

      finalSubscription =
        latestSubscription;

      if (
        finalSubscription
          .cancel_at_period_end !==
        true
      ) {
        return NextResponse.json(
          {
            ok: false,
            error:
              "구독 상태가 변경되었습니다. 다시 확인해주세요.",
          },
          {
            status: 409,
          },
        );
      }
    }


    /*
     * =====================================================
     * 8. Billing Event
     * =====================================================
     */

    const {
      error: eventError,
    } =
      await admin
        .from("billing_events")
        .insert({
          company_id:
            company.id,

          subscription_id:
            finalSubscription.id,

          payment_id:
            null,

          event_type:
            "subscription_cancel_scheduled",

          provider:
            "toss",

          event_data: {
            plan_code:
              finalSubscription.plan_code,

            current_period_end:
              finalSubscription.current_period_end,

            requested_by:
              user.id,

            requested_by_role:
              profile.role,

            requested_at:
              now,
          },
        });

    if (eventError) {
      console.error(
        "[billing/cancel] billing event error:",
        eventError,
      );
    }


    /*
     * =====================================================
     * 9. 알림
     * =====================================================
     */

    await createCancellationNotifications({
      admin,
      company,
      subscription:
        finalSubscription,
      userId:
        user.id,
    });


    /*
     * =====================================================
     * 10. 성공 응답
     * =====================================================
     */

    return NextResponse.json(
      {
        ok: true,

        cancelScheduled: true,

        message:
          "구독 취소가 예약되었습니다. 현재 결제기간까지 이용할 수 있으며 이후 자동결제되지 않습니다.",

        subscription: {
          id:
            finalSubscription.id,

          plan_code:
            finalSubscription.plan_code,

          status:
            finalSubscription.status,

          current_period_start:
            finalSubscription
              .current_period_start,

          current_period_end:
            finalSubscription
              .current_period_end,

          next_billing_at:
            finalSubscription
              .next_billing_at,

          cancel_at_period_end:
            finalSubscription
              .cancel_at_period_end,

          canceled_at:
            finalSubscription
              .canceled_at,
        },
      },
      {
        status: 200,
      },
    );
  } catch (error) {
    console.error(
      "[billing/cancel] error:",
      error,
    );

    return NextResponse.json(
      {
        ok: false,
        error:
          error?.message ||
          "구독 취소 예약 중 오류가 발생했습니다.",
        code:
          "BILLING_CANCEL_ERROR",
      },
      {
        status: 500,
      },
    );
  }
}
